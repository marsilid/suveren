{% extends "base.html.j2" %}
{% block title %}{{ brand.name if brand else 'Suveren' }} — {{ report.target }}{% endblock %}
{% block content %}
  <header class="top">
    {% if brand %}<span class="brand">{% if brand.logo %}<img class="brand-logo" src="{{ brand.logo }}" alt="">{% endif %}{{ brand.name }}</span>{% else %}<span class="brand">Suveren</span>{% endif %}
    <span class="meta">
      {{ report.started_at.strftime("%d.%m.%Y %H:%M UTC") }} · {{ "%.1f" | format(report.duration) }} с
    </span>
  </header>
  <h1>{{ report.target }}</h1>

  <section class="card summary">
    <div class="grade grade-{{ report.grade }}">{{ report.grade }}</div>
    <div>
      <div class="score"><strong>{{ report.score }}</strong> / 100 — независимость от иностранных сервисов</div>
      <div class="counts">
        Иностранных сервисов: <b>{{ report.foreign_count }}</b> · российских: <b>{{ report.domestic_count }}</b>
      </div>
      {% if bars %}
      <div class="bar">
        {% for b in bars %}<span style="width: {{ b.share }}%; background: {{ b.color }}" title="{{ b.name }} {{ b.share }}%"></span>{% endfor %}
      </div>
      <div class="legend">
        {% for b in bars %}<span><i style="background: {{ b.color }}"></i>{{ b.name }} {{ b.share }}%</span>{% endfor %}
      </div>
      {% endif %}
    </div>
  </section>

  {% if actions %}
  <h2>Что сделать в первую очередь</h2>
  <ol class="card actions">
    {% for a in actions %}
    <li class="sev-{{ a.severity.label }}"><span>{{ a.action }}</span><small>{{ a.reason }}</small></li>
    {% endfor %}
  </ol>
  {% endif %}

  {% if report.notes %}
  <h2>Замечания</h2>
  {% for note in report.notes %}
  <p class="card note">{{ note }}</p>
  {% endfor %}
  {% endif %}

  <h2>Риски</h2>
  {% for f in report.sorted_findings() %}
  <article class="card finding sev-{{ f.severity.label }}">
    <div class="head">
      <span class="badge"><span>{{ f.severity.ru }}</span></span>
      <h3>{{ f.title }}</h3>
    </div>
    <p>{{ f.description }}</p>
    <p class="fix">{{ f.recommendation }}</p>
    {% set m = moves.get(f.category) %}
    {% if m %}
    <details class="move">
      <summary>Как переехать · {{ m.difficulty_ru }} · {{ m.cost }}</summary>
      <ol>{% for s in m.steps %}<li>{{ s }}</li>{% endfor %}</ol>
      <p class="muted-sum">Российские варианты: {{ m.alternatives | join(", ") }}.</p>
    </details>
    {% endif %}
  </article>
  {% else %}
  <p class="empty">Иностранных зависимостей не найдено.</p>
  {% endfor %}

  {% set fines = report.fines %}
  {% for group, items in report.check_groups %}
  <h2 id="checks-{{ loop.index }}">{{ group }}</h2>
  {% if fines and group.startswith("Персональные") %}
  <div class="card fines">
    {% if fines.counted %}
    <h3>Потенциальные штрафы: до {{ fines.total("legal") | rub }} для юрлица</h3>
    <p class="muted-sum">Для ИП — до {{ fines.total("sole_trader") | rub }}. Сумма максимальных штрафов по найденным проблемам, по одной статье на каждую.</p>
    {% else %}
    <h3>Проблем, за которые есть штраф, не найдено</h3>
    <p class="muted-sum">Есть признаки, за которые штраф возможен в зависимости от обстоятельств.</p>
    {% endif %}
    <div class="table-wrap">
    <table>
      <thead><tr><th>Нарушение</th><th>Статья</th><th>Юрлицо</th><th>ИП</th><th>Должностное лицо</th><th>Повторно, юрлицо</th></tr></thead>
      <tbody>
      {% for i in fines.items %}
        <tr{% if not i.counted %} class="possible"{% endif %}>
          <td>{{ i.title }}{% if i.note %}<br><small>{{ i.note }}</small>{% endif %}{% if not i.counted %}<br><small>«внимание»: не входит в сумму</small>{% endif %}</td>
          <td><a href="{{ i.fine.url }}" target="_blank" rel="noopener">{{ i.fine.article }}</a></td>
          <td>{{ i.fine.legal | span }}</td>
          <td>{{ i.fine.sole_trader | span }}</td>
          <td>{{ i.fine.official | span }}</td>
          <td>{% if i.fine.repeat_legal %}{{ i.fine.repeat_legal | span }} ({{ i.fine.repeat_article }}){% else %}—{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    <p class="muted-sum">{{ fines_disclaimer }}</p>
  </div>
  {% endif %}
  {% if group.startswith("Персональные") or group.startswith("Другие требования") %}<p class="muted-note">Автоматическая проверка по признакам на страницах сайта. Она указывает на возможные проблемы и не заменяет юридическую оценку.</p>{% endif %}
  <div class="card checks">
    {% for c in items %}
    <div class="check">
      <span class="icon st-{{ c.status.value }}" title="{{ c.status.ru }}"><span>{{ c.status.icon }}</span></span>
      <h3>{{ c.title }}{% if c.id %} <span class="cid">{{ c.id }}</span>{% endif %}</h3>
      {% if c.details %}<p>{{ c.details }}{% if c.link %} <a href="{{ c.link }}" target="_blank" rel="noopener">открыть</a>{% endif %}</p>{% endif %}
      {% if c.recommendation and c.status.value != "ok" %}<p class="fix">{{ c.recommendation }}</p>{% endif %}
      {% if c.law %}<p class="law">Основание: {% if c.law_url %}<a href="{{ c.law_url }}" target="_blank" rel="noopener">{{ c.law }}</a>{% else %}{{ c.law }}{% endif %}</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% if group.startswith("Безопасность") and graph_svg %}
  <div class="card graph-card">
    <p class="muted-sum">Кто подключает сторонний код: слева сайт, правее — то, что подключили уже чужие скрипты (выделено).</p>
    {{ graph_svg }}
  </div>
  {% endif %}
  {% if group.startswith("Отключение") and shots.cutoff_before and shots.cutoff_after %}
  <div class="card cutoff">
    <figure><img src="{{ shots.cutoff_before }}" alt="Сайт как обычно"><figcaption>Как обычно</figcaption></figure>
    <figure><img src="{{ shots.cutoff_after }}" alt="Сайт без иностранных сервисов"><figcaption>Без иностранных сервисов</figcaption></figure>
  </div>
  {% endif %}
  {% endfor %}

  {% if plan %}
  <h2>План переезда</h2>
  <p class="muted-note">Сначала — то, что опаснее и проще перенести. Стоимость ориентировочная: цены провайдеров меняются.</p>
  <div class="card table-wrap">
    <table>
      <thead><tr><th>#</th><th>Что перенести</th><th>Риск</th><th>Сложность</th><th>Куда</th></tr></thead>
      <tbody>
      {% for m in plan %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>{{ m.category.title }}<br><small>{{ m.services | join(", ") }}</small></td>
          <td><span class="badge sev-{{ m.severity.label }}"><span>{{ m.severity.ru }}</span></span></td>
          <td>{{ m.difficulty_ru }}<br><small>{{ m.cost }}</small></td>
          <td>{{ m.alternatives[:3] | join(", ") }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <h2>Все найденные сервисы</h2>
  <div class="card table-wrap">
    <table>
      <thead><tr><th>Сервис</th><th>Страна</th><th>Где найдено</th><th>Риск</th></tr></thead>
      <tbody>
      {% for category, deps in groups %}
        <tr class="group"><td colspan="4">{{ category.title }}</td></tr>
        {% for d in deps %}
        <tr>
          <td>{{ d.service }}</td>
          <td>{{ d.country_ru }}</td>
          <td class="evidence">{{ d.evidence }}</td>
          <td>
            {% if d.foreign %}<span class="badge sev-{{ d.severity.label }}"><span>{{ d.severity.ru }}</span></span>
            {% elif d.foreign is sameas false %}<span class="badge sev-ok"><span>РФ</span></span>
            {% else %}<span class="empty">—</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      {% endfor %}
      </tbody>
    </table>
  </div>

  <footer>
    {% if brand %}Отчёт подготовил {% if brand.url %}<a href="{{ brand.url }}">{{ brand.name }}</a>{% else %}{{ brand.name }}{% endif %}. Сделано с помощью Suveren v{{ version }}{% else %}Отчёт создан Suveren v{{ version }}{% endif %}. Проверка пассивная: публичные DNS-записи, WHOIS,
    SSL-сертификат, код главной страницы и открытые реестры. Страна сервиса — юрисдикция компании-владельца.
    Оценка помогает расставить приоритеты и не является юридическим заключением.
  </footer>
{% endblock %}
