{% extends "base.html.j2" %}
{% block title %}{{ brand.name if brand else 'Suveren' }} — сводка по {{ rows | length }} сайтам{% endblock %}
{% block content %}
  <header class="top">
    {% if brand %}<span class="brand">{% if brand.logo %}<img class="brand-logo" src="{{ brand.logo }}" alt="">{% endif %}{{ brand.name }}</span>{% else %}<span class="brand">Suveren · массовая проверка</span>{% endif %}
    <span class="meta">{{ generated.strftime("%d.%m.%Y %H:%M") }}</span>
  </header>
  <h1>Проверено сайтов: {{ rows | length }}</h1>

  <div class="card table-wrap">
    <table>
      <thead>
        <tr><th>Сайт</th><th>Общая оценка</th><th>Независимость</th><th>Иностранных / российских</th><th class="nowrap">152-ФЗ</th><th>Главные риски</th></tr>
      </thead>
      <tbody>
      {% for row in rows %}
        {% set r = row.report %}
        <tr>
          <td class="nowrap"><a href="{{ r.target }}.html">{{ r.target }}</a>{% if row.blocked %}<br><span class="badge sev-high"><span>заблокирован</span></span>{% endif %}</td>
          <td><span class="mini-grade grade-{{ row.grade }}">{{ row.grade }}</span> {{ row.score }}{% if row.missed %}<br><small class="empty">неполная, не проверены: {{ row.missed | join(", ") }}</small>{% elif row.unchecked %}<br><small class="empty">не проверено {{ row.unchecked[0] }} из {{ row.unchecked[1] }}</small>{% endif %}</td>
          <td><span class="grade-{{ r.grade }}">{{ r.score }}</span> / 100</td>
          <td>{{ r.foreign_count }} / {{ r.domestic_count }}</td>
          <td class="nowrap">
            {% if row.fails %}<span class="st-fail">✗ {{ row.fails }}</span>{% endif %}
            {% if row.warns %}<span class="st-warn">! {{ row.warns }}</span>{% endif %}
            {% if not row.fails and not row.warns %}<span class="st-ok">✓</span>{% endif %}
          </td>
          <td>{% for f in row.top %}{{ f.title }}{% if not loop.last %}<br>{% endif %}{% else %}<span class="empty">нет</span>{% endfor %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  {% if failed %}
  <h2>Не удалось проверить</h2>
  <div class="card">
    <ul>{% for host, error in failed %}<li>{{ host }} — {{ error }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  <footer>
    {% if brand %}Отчёт подготовил {% if brand.url %}<a href="{{ brand.url }}">{{ brand.name }}</a>{% else %}{{ brand.name }}{% endif %}. Сделано с помощью Suveren v{{ version }}{% else %}Отчёт создан Suveren v{{ version }}{% endif %}. Подробности по каждому сайту открываются по ссылке.
    Оценка помогает расставить приоритеты и не является юридическим заключением.
  </footer>
{% endblock %}
